# IraSoft Technologies Environment Configuration

# Transactional Email (Resend)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# From email address (e.g. IraSoft Enquiries <enquiry@irasofttech.in>)
RESEND_FROM_EMAIL="IraSoft Technologies <enquiry@irasofttech.in>"

# Notification destination for new enquiries
ENQUIRY_NOTIFICATION_EMAIL=enquiry@irasofttech.in

# Site Metadata & Domain
NEXT_PUBLIC_SITE_URL=https://irasofttech.in

# Optional: Google Analytics 4 (Measurement ID: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google Search Console verification meta tag
NEXT_PUBLIC_GSC_VERIFICATION=

